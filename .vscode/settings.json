{
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "css.validate": true,
  "scss.validate": true,
  "editor.quickSuggestions": {
    "strings": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "always"
    }
  }
}
